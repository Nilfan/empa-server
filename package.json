{
  "name": "empa-server",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit false --outDir dist",
    "start": "npm run build && node dist/src/index.js",
    "watch": "node --watch-path=src src/index.ts",
    "web-app:dev": "vite",
    "web-app:build": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "web-app:typecheck": "tsc --project web-app/tsconfig.json --noEmit",
    "test:db:migrate": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/EmpaTestDB tsx scripts/test-db.ts migrate",
    "test:db:reset": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/EmpaTestDB tsx scripts/test-db.ts reset",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "preact": "^10.28.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  }
}
